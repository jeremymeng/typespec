{
  "name": "@typespec/compiler-rust",
  "version": "0.0.0",
  "private": true,
  "description": "Learning-project Rust port scaffold for the TypeSpec compiler.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release --esm --manifest-path ../../crates/typespec-napi/Cargo.toml --output-dir .",
    "build:debug": "napi build --platform --esm --manifest-path ../../crates/typespec-napi/Cargo.toml --output-dir .",
    "build:spike": "node -e \"console.log('Spike crate is frozen on napi v2; see docs/rust-port/spike-napi-roundtrip.md')\"",
    "test": "vitest run"
  },
  "napi": {
    "binaryName": "compiler-rust",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.0",
    "vitest": "catalog:"
  }
}
